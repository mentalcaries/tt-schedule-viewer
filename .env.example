CALENDLY_ORGANIZATION_URI=https://api.calendly.com/organizations/<organization-id>
CALENDLY_TEAMS=[{"slug":"aise","name":"AISE","groupUri":"https://api.calendly.com/groups/<aise-group-id>","tokenEnv":"CALENDLY_TOKEN_AISE"},{"slug":"ui-ux","name":"UI/UX","groupUri":"https://api.calendly.com/groups/<ui-ux-group-id>","tokenEnv":"CALENDLY_TOKEN_UI_UX"}]
CALENDLY_TOKEN_AISE=replace-with-the-aise-calendly-personal-access-token
CALENDLY_TOKEN_UI_UX=replace-with-the-ui-ux-calendly-personal-access-token
DISPLAY_TIMEZONE=America/New_York
